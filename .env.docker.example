# WorkMesh AI — Docker Compose Environment Template
# Copy to .env in the repository root before running `docker compose up --build`

POSTGRES_USER=postgres
POSTGRES_PASSWORD=workmesh_dev_pw
POSTGRES_DB=workmesh

JWT_ACCESS_SECRET=replace_with_32_plus_char_random_secret
INTERNAL_API_KEY=replace_with_shared_internal_service_key
CORS_ORIGINS=http://localhost:3000

# Google Gemini API key (for RAG synthesis, embeddings, and LangGraph supervisor)
GEMINI_API_KEY=

# S3 / Neon Object Storage credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=assets

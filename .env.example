# ============================================================
# WorkMesh AI — Environment Variables Example
# Copy this file to .env (never commit .env)
# Replace all placeholder values with real values locally
# ============================================================

# --- Shared ---
NODE_ENV=development

# --- Backend (Node/Express) ---
PORT=4000

# Database (Phase 3+) — required
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/workmesh

# JWT secrets (added in Phase 4)
# JWT_ACCESS_SECRET=replace-me-locally

# Internal AI service communication (added in Phase 4)
# AI_SERVICE_URL=http://localhost:8000
# INTERNAL_AI_SERVICE_TOKEN=replace-me-locally

# --- AI Service (FastAPI) ---
# port=8000
# environment=development
# debug=false

# Database (Phase 3+) — required
# DATABASE_URL is shared — use the same value as backend above

# LLM and embedding (added in Phase 7)
# LLM_PROVIDER=openai
# LLM_API_KEY=replace-me-locally
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Object Storage / Cloudflare R2 (added in Phase 6) ---
# R2_ACCOUNT_ID=replace-me-locally
# R2_ACCESS_KEY_ID=replace-me-locally
# R2_SECRET_ACCESS_KEY=replace-me-locally
# R2_BUCKET_NAME=replace-me-locally
